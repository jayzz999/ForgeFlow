# ForgeFlow production template. Copy to .env.production and fill real values.

FORGEFLOW_ENV=production
FORGEFLOW_ENABLE_DEMO_ENDPOINTS=0
FORGEFLOW_ADMIN_TOKEN=replace-with-a-long-random-secret
FORGEFLOW_ALLOW_UNAUTH_DANGEROUS=0
FORGEFLOW_VAULT_KEY=replace-with-a-different-long-random-secret
FORGEFLOW_QUEUE_WORKER=1
FORGEFLOW_QUEUE_WORKER_INTERVAL=10
FORGEFLOW_QUEUE_WORKER_BATCH=5
FORGEFLOW_RUNTIME_BASE_URL=https://your-forgeflow-runtime.example.com
FORGEFLOW_MCP_RUNTIME_ENABLED=0

LLM_PROVIDER=groq
LLM_FALLBACK_PROVIDER=openai
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_FAST_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
EMBEDDING_PROVIDER=local

SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_NOTIFICATION_CHANNEL=#forgeflow-alerts
SLACK_SOCKET_MODE=0
SLACK_DISABLED=1

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://your-forgeflow-runtime.example.com/api/connectors/oauth/callback
GMAIL_ACCESS_TOKEN=
GMAIL_SENDER_EMAIL=
GOOGLE_SHEETS_ACCESS_TOKEN=
GOOGLE_CALENDAR_ACCESS_TOKEN=

STRIPE_API_KEY=
ZENDESK_API_TOKEN=
ZENDESK_EMAIL=
ZENDESK_SUBDOMAIN=
HUBSPOT_ACCESS_TOKEN=
OKTA_API_TOKEN=
OKTA_ORG_URL=
GITHUB_TOKEN=
RENDER_API_KEY=

CHROMA_PERSIST_DIR=/data/chroma_db
SANDBOX_TIMEOUT=60
DATABASE_URL=sqlite+aiosqlite:////data/forgeflow.db
