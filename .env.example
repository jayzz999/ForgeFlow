# ForgeFlow Environment Variables
# Copy to .env and fill in your values.

# LLM provider
LLM_PROVIDER=groq
LLM_FALLBACK_PROVIDER=gemini
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant
GROQ_MAX_RETRIES=2
GROQ_RETRY_BASE_SECONDS=1

# Optional Gemini fallback
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Use local Chroma embeddings by default to avoid API costs.
EMBEDDING_PROVIDER=local

# Slack Bot
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_APP_TOKEN=xapp-your-slack-app-token
SLACK_SIGNING_SECRET=your-slack-signing-secret
SLACK_NOTIFICATION_CHANNEL=#forgeflow-alerts
SLACK_DISABLED=0

# Google OAuth-backed connectors
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/connectors/oauth/callback
GMAIL_ACCESS_TOKEN=
GMAIL_SENDER_EMAIL=
GOOGLE_SHEETS_ACCESS_TOKEN=
GOOGLE_SHEET_ID=your-google-sheet-id
GOOGLE_CALENDAR_ACCESS_TOKEN=

# Catalog connector credentials
STRIPE_API_KEY=
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=
HUBSPOT_ACCESS_TOKEN=
SALESFORCE_INSTANCE_URL=
SALESFORCE_ACCESS_TOKEN=
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
NOTION_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TOKEN=
MICROSOFT_GRAPH_TOKEN=
OKTA_ORG_URL=
OKTA_API_TOKEN=

# Legacy/generated workflow compatibility
GMAIL_ADDRESS=your-email@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password
GOOGLE_API_KEY=your-google-api-key

# Optional generic integration keys
WEBHOOK_API_TOKEN=
API_TOKEN=

# Pipeline config
CHROMA_PERSIST_DIR=./chroma_db
SANDBOX_TIMEOUT=60

# Admin guard for endpoints that execute generated code.
FORGEFLOW_ENV=development
FORGEFLOW_ENABLE_DEMO_ENDPOINTS=1
FORGEFLOW_ADMIN_TOKEN=change-me
FORGEFLOW_ALLOW_UNAUTH_DANGEROUS=0
FORGEFLOW_VAULT_KEY=
FORGEFLOW_QUEUE_WORKER=0
FORGEFLOW_RUNTIME_BASE_URL=
FORGEFLOW_MCP_RUNTIME_ENABLED=0
